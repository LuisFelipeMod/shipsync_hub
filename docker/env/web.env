# Overrides para o serviço `web` (rede Docker). Carregado DEPOIS do `.env` do projeto.
# Host no browser: localhost:8000 — hosts abaixo são nomes de serviço do Compose.

APP_URL=http://localhost:8000
OPENAPI_UI_ENABLED=true

REDIS_HOST=redis
REDIS_PORT=6379
PHP_CLI_SERVER_WORKERS=1

MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

AWS_ENDPOINT=http://localstack:4566

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=shipsync
RABBITMQ_PASSWORD=shipsync

QUEUE_CONNECTION=sync
