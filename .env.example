APP_NAME=ShipSyncHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=memcached
SHIPPING_QUOTE_CACHE_TTL=3600
SHIPPING_RESILIENCE_ENABLED=true
SHIPPING_CARRIER_MAX_ATTEMPTS=3
SHIPPING_CARRIER_BACKOFF_BASE_MS=100
SHIPPING_CARRIER_BACKOFF_MAX_MS=5000
SHIPPING_CARRIER_CIRCUIT_KEY=default-carrier
SHIPPING_CARRIER_CIRCUIT_FAILURE_THRESHOLD=5
SHIPPING_CARRIER_CIRCUIT_OPEN_SECONDS=30
SHIPPING_CARRIER_CIRCUIT_STATE_TTL=3600

OPENAPI_UI_ENABLED=true
OPENAPI_UI_PATH=api/documentation
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_BUCKET=shipsync-local
AWS_USE_PATH_STYLE_ENDPOINT=true

DYNAMODB_TABLE=shipsync-records
SQS_QUEUE=shipsync-jobs
SQS_DLQ=shipsync-jobs-dlq

NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME="${APP_NAME}"
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING=true

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=shipsync
RABBITMQ_PASSWORD=shipsync
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=shipsync-jobs

VITE_APP_NAME="${APP_NAME}"
